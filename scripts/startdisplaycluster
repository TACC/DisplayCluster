#!/bin/bash
# Starts a DisplayCluster wall from its apptainer image (displaycluster.sif).
#
# This is the one file a wall needs outside the image: copy it somewhere on
# the PATH (e.g. ~/bin) and edit the settings below for the site. A copy is
# in every image too, so a site needs no checkout of the repo to get one:
#
#   apptainer exec displaycluster.sif cat /usr/local/src/DisplayCluster/scripts/startdisplaycluster > ~/bin/startdisplaycluster
#
# Every setting is an environment variable, and one already set in the
# environment wins over the value here. Every DISPLAYCLUSTER_* variable is
# passed on to all of the wall's processes, so others can be added freely;
# doc/remote-control.md lists those for the remote API and web UI.
#
# MPI runs rank 0 (the control process, which also serves the remote API) on
# this machine and one rank per "processes" entry in the configuration, on
# that entry's host. The host's Open MPI must match the image's (see README).

# --- site settings -----------------------------------------------------------

# the image, and the wall's layout
export DISPLAYCLUSTER_SIF=${DISPLAYCLUSTER_SIF:-$HOME/displaycluster.sif}
export DISPLAYCLUSTER_CONFIG=${DISPLAYCLUSTER_CONFIG:-$HOME/wall.json}

# the wall's working directory
CONTENT_DIR=${CONTENT_DIR:-$HOME/Content}

# folders the web UI's file browser shows, as name=path pairs separated by colons
export DISPLAYCLUSTER_MEDIA_DIRS=${DISPLAYCLUSTER_MEDIA_DIRS:-content=$CONTENT_DIR}

# remote API and web UI port; the token, certificate and key are read from
# ~/.displaycluster/ (api_token, api_cert.pem, api_key.pem) if they're there
export DISPLAYCLUSTER_API_PORT=${DISPLAYCLUSTER_API_PORT:-1910}

# screensaver: seconds without activity before it starts, and its image
export DISPLAYCLUSTER_TIMEOUT=${DISPLAYCLUSTER_TIMEOUT:-10800}
export DISPLAYCLUSTER_SCREENSAVER_IMAGE=${DISPLAYCLUSTER_SCREENSAVER_IMAGE:-/usr/local/src/DisplayCluster/examples/tacc-logo.png}

# how many sensors the web UI offers for sensor control (0: none)
export DISPLAYCLUSTER_SENSORS=${DISPLAYCLUSTER_SENSORS:-0}

# extra mpirun arguments. Name the network interface if Open MPI picks the
# wrong one, e.g. "--mca btl_tcp_if_include enp0s25"
export DISPLAYCLUSTER_MPIARGS=${DISPLAYCLUSTER_MPIARGS:-"-bind-to none"}

export DISPLAYCLUSTER_LOG_THRESHOLD=${DISPLAYCLUSTER_LOG_THRESHOLD:-4}

# --- paths inside the image; these rarely need changing ----------------------

export DISPLAYCLUSTER_INSTALL=${DISPLAYCLUSTER_INSTALL:-/usr/local}
export DISPLAYCLUSTER_DIR=${DISPLAYCLUSTER_DIR:-$DISPLAYCLUSTER_INSTALL}
export DISPLAYCLUSTER_EXEC=${DISPLAYCLUSTER_EXEC:-displaycluster}
DISPLAYCLUSTER_SCRIPTS=${DISPLAYCLUSTER_SCRIPTS:-/usr/local/src/DisplayCluster/scripts}

# --- launch -------------------------------------------------------------------

for f in "$DISPLAYCLUSTER_SIF" "$DISPLAYCLUSTER_CONFIG"; do
    if [ ! -r "$f" ]; then
        echo "startdisplaycluster: can't read $f" >&2
        exit 1
    fi
done

MPIRUN=$(command -v mpirun) || { echo "startdisplaycluster: no mpirun on the PATH" >&2; exit 1; }

# rank 0 here, then one rank per process in the configuration
HOSTS=$(python3 -c '
import json, sys
print(",".join(["localhost"] + [p["host"] for p in json.load(open(sys.argv[1]))["processes"]]))
' "$DISPLAYCLUSTER_CONFIG") || { echo "startdisplaycluster: can't read the hosts from $DISPLAYCLUSTER_CONFIG" >&2; exit 1; }

FORWARD=()
for v in $(compgen -e | grep '^DISPLAYCLUSTER_'); do
    FORWARD+=(-x "$v")
done

cd "$CONTENT_DIR" || exit 1

# DISPLAYCLUSTER_MPIARGS is split into words on purpose
COMMAND=("$MPIRUN" -host "$HOSTS" $DISPLAYCLUSTER_MPIARGS "${FORWARD[@]}"
         apptainer run --nv "$DISPLAYCLUSTER_SIF"
         sh "$DISPLAYCLUSTER_SCRIPTS/displaycluster.sh" "$DISPLAYCLUSTER_SCRIPTS/displaycluster.py")

echo "launching: ${COMMAND[*]}"

# exec, so Ctrl-C and kill reach mpirun, which stops every rank
exec "${COMMAND[@]}"
